# Copy to docker/.env.prod and fill in real values. docker/.env.prod is gitignored.
# Generate secrets with a password manager; never reuse development values.

# PostgreSQL
POSTGRES_DB=lzdetailingstore
POSTGRES_USER=lzdetailing
POSTGRES_PASSWORD=

# JWT (secret must be at least 32 bytes)
JWT_SECRET=
JWT_ISSUER=LzDetailingStore
JWT_AUDIENCE=LzDetailingStoreApp
JWT_EXPIRES_IN_HOURS=24

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Banxico (USD/MXN exchange rate)
BANXICO_TOKEN=

# Frontend (also used as the single allowed CORS origin)
FRONTEND_URL=https://example.com

# S3-compatible storage (Fleekware)
STORAGE_SERVICE_URL=
STORAGE_BUCKET_NAME=public
STORAGE_CDN_BASE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# OpenTelemetry (leave empty to disable the OTLP exporter)
OTLP_ENDPOINT=
